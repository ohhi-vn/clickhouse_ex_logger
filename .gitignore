# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
clickhouse_ex_logger-*.tar

# AppleDouble sidecar files. macOS writes a 4096-byte `._name` beside any file
# carrying an extended attribute when the filesystem cannot store the attribute
# itself, which exFAT and SMB volumes cannot — so every file this toolchain
# writes gets one. Ignore them.
#
# `mix test` clears the ones under `_build/` before it runs (see
# `purge_sidecars/1` in mix.exs), because `:cover` hands a stub to the Erlang
# compiler and aborts the run. If you invoke the task some other way, or a build
# breaks mysteriously with "corrupt file header" or "table name already exists",
# run `find . -name '._*' -delete`.
._*
**/._*
.DS_Store

.opencode
.expert
.dexter.db*
